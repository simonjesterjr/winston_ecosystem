    ("wq", ("quiver", "wq ", "wq-", "shadow")),
    ("dm", ("data_manager", "data-manager", " eodhd", "parquet", "dm ", "dm-", "watermark")),
    ("wut", ("winston_unit_test", "wut ", "wut-", "pbr", "backtest")),
    ("bg", ("broker_gateway", "broker-gateway", "ibkr", "bg ", "bg-")),
    ("wv2", ("winston_v2", "wv2", "ops-shell", "desk", "dar ", "fulfillment", "pulse", "book board")),
    ("ecosystem", ("ecosystem", "cromwell", "mcp", "cable", "hotwire")),
)

