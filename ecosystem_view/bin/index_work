def owner_for(text: str) -> str:
    t = " " + text.lower().replace("_", " ").replace("/", " ") + " "
    for oid, keys in OWNERS:
        if any(k in t for k in keys):
            return oid
    return "ecosystem"


def first_heading(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def meta_status(text: str) -> str:
    m = re.search(r"\*\*Status:\*\*\s*(.+)", text)
    if m:
        return m.group(1).strip()[:80]
    m = re.search(r"^\|\s*\*\*Status\*\*\s*\|\s*(.+?)\s*\|", text, re.M)
    if m:
        return m.group(1).strip()[:80]
    return ""


def clip_body(text: str) -> str:
    text = text.replace("\r\n", "\n")
    if len(text) <= BODY_CAP:
        return text
    return text[:BODY_CAP] + "\n\n… truncated …"


def item(kind, path: Path, owner_src: str, rel: str) -> dict:
    text = path.read_text(errors="replace") if path.exists() else ""
    title = first_heading(text) or path.stem
    return {
        "kind": kind,
        "id": path.stem,
        "title": title,
        "status": meta_status(text) or "",
        "owner": owner_for(owner_src + " " + title + " " + path.stem),
        "path": rel,
        "body": clip_body(text) if text else "(file not found on disk)",
    }


def collect() -> dict:
    items = []
    for p in sorted((ECO / "docs" / "adr").glob("ADR-*.md")):
        items.append(item("adr", p, p.stem, str(p.relative_to(ECO))))

    idx = ECO / "docs" / "tickets" / "INDEX.md"
    if idx.exists():
        for line in idx.read_text(errors="replace").splitlines():
            if not line.startswith("|") or "File" in line or line.startswith("|---") or "Priority |" in line:
                continue
            cols = [c.strip() for c in line.strip("|").split("|")]
            if len(cols) < 4:
                continue
            pri, status, file_col, title = cols[0], cols[1], cols[2], cols[3]
            m = re.search(r"\(([^)]+\.md)\)", file_col) or re.search(r"`([^`]+\.md)`", file_col)
            fname = m.group(1) if m else ""
            if not fname:
                continue
            path = ECO / "docs" / "tickets" / fname
            if not path.exists():
                path = ECO / "docs" / "tickets" / "archive" / Path(fname).name
            rec = item("ticket", path, title + " " + fname, f"docs/tickets/{fname}")
            rec["title"] = title
            rec["status"] = f"{pri} {status}"
            items.append(rec)

    for p in sorted((ECO / "docs" / "issues").glob("*.md")):
        if p.name.startswith("_"):
            continue
        items.append(item("issue", p, p.read_text(errors="replace")[:800], str(p.relative_to(ECO))))

    for p in sorted((ECO / "plans").glob("*.md")):
        if "candidate" in p.name:
            continue
        items.append(item("plan", p, p.read_text(errors="replace")[:800], str(p.relative_to(ECO))))

    return {
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "nodes": NODES,
        "items": items,
    }


def main() -> int:
    payload = collect()
    text = json.dumps(payload)
    for out in OUTS:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text + "\n")
        print(f"wrote {out} items={len(payload['items'])} bytes={out.stat().st_size}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
